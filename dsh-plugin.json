{
    "$schema":  "https://dsh.community/schemas/dsh-plugin-0.15.json",
    "id":  "dsh-ego-local-browser",
    "name":  "ego-local-browser",
    "version":  "1.2.0",
    "manifestVersion":  "0.15",
    "facets":  {
                   "host":  {
                                "entry":  "lib/index.js",
                                "apiVersion":  "v1alpha1"
                            }
               },
    "requires":  {
                     "contracts":  [
                                       {
                                           "apiVersion":  "presentation.dsh/v1alpha1",
                                           "kind":  "OpenExternal",
                                           "optional":  true,
                                           "fallback":  "report the URL as text instead of opening it"
                                       },
                                       {
                                           "apiVersion":  "presentation.dsh/v1alpha1",
                                           "kind":  "Notification",
                                           "optional":  true,
                                           "fallback":  "log the notice to the browser-status scene"
                                       }
                                   ]
                 },
    "permissions":  [

                    ],
    "contributes":  {
                        "commands":  [

                                     ],
                        "x-dsh-tui":  [
                                          {
                                              "apiVersion":  "tui.dsh/v1alpha1",
                                              "kind":  "Scene",
                                              "id":  "dsh-ego-local-browser.watch",
                                              "name":  "agent_browser",
                                              "spec":  {
                                                           "title":  "Agent 浏览器",
                                                           "titles":  {
                                                                          "en":  "Agent Browser",
                                                                          "zh":  "Agent 浏览器"
                                                                      }
                                                       }
                                          },
                                          {
                                              "apiVersion":  "tui.dsh/v1alpha1",
                                              "kind":  "SettingsSection",
                                              "id":  "dsh-ego-local-browser.settings",
                                              "name":  "ego_browser_settings",
                                              "spec":  {
                                                           "namespace":  "ego-browser",
                                                           "title":  "Agent 浏览器",
                                                           "titles":  {
                                                                          "en":  "Agent Browser",
                                                                          "zh":  "Agent 浏览器"
                                                                      },
                                                           "fields":  [
                                                                          {
                                                                              "path":  [
                                                                                           "isolateSpaces"
                                                                                       ],
                                                                              "label":  "任务空间沙盒隔离 (Space isolation)",
                                                                              "kind":  "boolean",
                                                                              "hint":  "默认关闭：使用磁盘持久化 Profile，任务中登录的账号跨电脑重启永久保留；开启后使用内存临时沙盒隔离，任务结束不落盘。"
                                                                          },
                                                                          {
                                                                              "path":  [
                                                                                           "idleTimeoutMin"
                                                                                       ],
                                                                              "label":  "空闲自动回收 (Idle auto-stop, minutes)",
                                                                              "kind":  "number",
                                                                              "hint":  "N 分钟没有任何 ego_* 调用后自动关闭后台浏览器进程（0 = 关闭此功能）。下次调用会自动冷启动（约 2-4 秒）。观察窗正在观看不算活动。"
                                                                          },
                                                                          {
                                                                              "path":  [
                                                                                           "browserMode"
                                                                                       ],
                                                                              "label":  "浏览器策略 (Browser routing)",
                                                                              "kind":  "select",
                                                                              "options":  [
                                                                                              {
                                                                                                  "value":  "real",
                                                                                                  "label":  "优先真实浏览器，未连接时安全回退 agent"
                                                                                              },
                                                                                              {
                                                                                                  "value":  "real-only",
                                                                                                  "label":  "仅真实浏览器，未连接时报错"
                                                                                              },
                                                                                              {
                                                                                                  "value":  "agent",
                                                                                                  "label":  "仅 agent 浏览器"
                                                                                              }
                                                                                          ]
                                                                          },
                                                                          {
                                                                              "path": [
                                                                                  "autoStartBridge"
                                                                              ],
                                                                              "label": "自动启动真实浏览器桥 (Auto-start bridge)",
                                                                              "kind": "boolean",
                                                                              "hint": "插件加载时启动本地桥；关闭后由 ego_real 按需启动。"
                                                                          },
                                                                          {
                                                                              "path":  [
                                                                                           "chromePath"
                                                                                       ],
                                                                              "label":  "Browser binary path",
                                                                              "kind":  "text",
                                                                              "hint":  "Path to the Chrome/Chromium/Edge binary. Empty = auto-detect."
                                                                          },
                                                                          {
                                                                              "path":  [
                                                                                           "captureBackend"
                                                                                       ],
                                                                              "label":  "Capture backend",
                                                                              "kind":  "select",
                                                                              "options":  [
                                                                                              {
                                                                                                  "value":  "auto",
                                                                                                  "label":  "Auto"
                                                                                              },
                                                                                              {
                                                                                                  "value":  "cdp",
                                                                                                  "label":  "CDP"
                                                                                              },
                                                                                              {
                                                                                                  "value":  "ffmpeg",
                                                                                                  "label":  "FFmpeg"
                                                                                              }
                                                                                          ]
                                                                          },
                                                                          {
                                                                              "path":  [
                                                                                           "streamProfile"
                                                                                       ],
                                                                              "label":  "Quality profile",
                                                                              "kind":  "select",
                                                                              "options":  [
                                                                                              {
                                                                                                  "value":  "balanced",
                                                                                                  "label":  "Balanced"
                                                                                              },
                                                                                              {
                                                                                                  "value":  "quality",
                                                                                                  "label":  "Quality"
                                                                                              },
                                                                                              {
                                                                                                  "value":  "speed",
                                                                                                  "label":  "Speed"
                                                                                              }
                                                                                          ]
                                                                          },
                                                                          {
                                                                              "path":  [
                                                                                           "ffmpegPath"
                                                                                       ],
                                                                              "label":  "FFmpeg binary path",
                                                                              "kind":  "text",
                                                                              "hint":  "Path to ffmpeg. Empty = auto-detect / on-demand install."
                                                                          }
                                                                      ]
                                                       }
                                          }
                                      ]
                    },
    "subscriptions":  [

                      ],
    "license":  "MIT",
    "source":  {
                   "repository":  "https://github.com/Fisfzy/dsh-ego-browser"
               },
    "compat":  {
                   "hosts":  [
                                 "dsh-tui"
                             ]
               }
}